{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AGENT_GATES_MODE": "report"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/pre-write-policy-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/team-boundaries-gate.sh pre"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/deploy-preflight.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/post-write-quality-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/post-write-architecture-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/team-boundaries-gate.sh post"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/rollout-observer.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/reinject-critical-context.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/batch-completion-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/delivery-log.sh"
          }
        ]
      }
    ]
  }
}
