# Repository-specific gate commands. Commands execute from repository root.

# Global mode: off | report | block. Keep this advisory until the project
# explicitly approves blocking enforcement.
AGENT_GATES_MODE=report

# Diarium does not currently configure a formatter task. Detekt is the static
# analysis/lint task used locally and in CI.
AGENT_FORMAT_CMD=""
AGENT_LINT_CMD="./gradlew detekt --stacktrace --no-daemon"

# Compile the same Kotlin targets used by CodeQL's manual build. iOS compilation
# is intentionally excluded because it requires macOS/Xcode.
AGENT_TYPECHECK_CMD="./gradlew :core:compileKotlinJvm :core:compileAndroidMain :app:sharedLogic:compileAndroidMain :app:sharedUI:compileAndroidMain :app:androidApp:compileDebugKotlin --stacktrace --no-daemon"

# Fast, non-device test gate from the main CI workflow.
AGENT_TEST_CMD="./gradlew :core:jvmTest :app:sharedLogic:allTests :app:sharedUI:allTests --stacktrace --no-daemon"
AGENT_CONTRACT_TEST_CMD="./gradlew :core:jvmTest --stacktrace --no-daemon"
AGENT_ACCEPTANCE_TEST_CMD="./gradlew :app:sharedLogic:allTests --stacktrace --no-daemon"

# ArchitectureFitnessTest (Konsist) runs in the core JVM suite and protects the
# core-to-app dependency boundary.
AGENT_ARCH_CMD="./gradlew :core:jvmTest --stacktrace --no-daemon"

# No repository-local security command is configured. GitHub CodeQL covers
# Actions, Kotlin/Java, and Swift in CI.
AGENT_SECURITY_CMD=""

# Diarium has no deployment CLI. Retain advisory detection for accidental
# Kubernetes/GitOps commands; no rollout health command is configured.
AGENT_DEPLOY_COMMAND_REGEX='(kubectl apply|helm upgrade|argocd app sync|argo rollouts)'
AGENT_ROLLOUT_HEALTH_CMD=""
